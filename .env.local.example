# Copy this file to .env.local and fill in your real values from
# Supabase → Project Settings → API. .env.local is gitignored — never commit
# real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Also required for account creation and the notification system's email
# dispatch (src/lib/notifications) — never NEXT_PUBLIC_-prefixed.
SUPABASE_SERVICE_ROLE_KEY=

# The notification email pipeline is deployed once, from the public repo
# (supabase/functions/send-notification-email, supabase/functions/send-test-email)
# — both repos share the same Supabase project, so nothing extra to deploy
# here. Its secrets are set via the Supabase CLI, never in this file:
#   supabase secrets set RESEND_API_KEY=... EMAIL_FROM="LUNEX TECH <notifications@your-verified-domain>" APP_URL=https://your-deployed-app
